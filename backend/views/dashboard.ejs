<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
</head>
<body>
 <div style="display: flex; flex-direction: column; gap: 2rem; height: 10rem; width: 55rem; justify-self: center;">
     
          <h1>wellcome to new home is very sweet home</h1>
           <a href="/logout">Logouts</a>
 
   
 </div>
    <form action="/task" method="Post" style="display: flex; margin-top: 10rem; flex-direction: column; gap: 1rem; height: 10rem; width: 15rem; justify-self: center; align-content: center;">
<label for="">Task</label>
        <input type="text" placeholder="enter task name" name="Task">
        <label for="">Discription</label>
        <input type="text" placeholder="enter description name" name="description">
        <button>submit</button>
    </form> 
    {
        <% data.map((iteam)=>{ %>
          <div style="height: 7rem; width: 40rem;  margin-top: 2rem;   border: 1px solid black; justify-self: center;">
        <h2>Task Name :<%= iteam.Task %> </h2>
        <h2> Description : <%= iteam.description %> </h2>
    </div>
        <% }) %>
    }
   
</body>
</html>